<p style="color: green"><%= notice %></p>

<%= form_with url: "/ceasers/#{@ceaser.id}/encode", method: :post do |form| %>
  <%= form.label :message %>
  <br />
  <%= form.text_area :message, cols: 100, rows: 8, value: 'The quick red fox jumped over the lazy, brown dog.' %>
  <br />
  <%= form.submit 'Encode' %>
<% end %>

<label>
  <span>Output</span>
  <br/>
  <textarea cols="100" rows="8"><%= @encoded_message %></textarea>
</label>

<div>
  <%= link_to "Edit this ceaser", edit_ceaser_path(@ceaser) %> |
  <%= link_to "Back", root_path %>
</div>
